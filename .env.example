# ==============================================================================
# Ron AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file containing real secrets to version control.

# Application Settings
PROJECT_NAME="Ron AI"

# Database Configuration (PostgreSQL 15+)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/ron_ai

# CORS Configuration (JSON array or comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Authentication & JWT Configuration
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter AI Gateway Configuration
# Obtain your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60.0
