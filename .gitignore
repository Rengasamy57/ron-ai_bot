# ==============================================================================
# Ron AI - Git Ignore Configuration
# ==============================================================================

# Python Bytecode and Compiler Artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# C extensions
*.so

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment and Secrets (CRITICAL: NEVER COMMIT REAL CREDENTIALS!)
.env
.env.*
*.env
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Logs and Runtime Diagnostics
*.log
stderr*.log
stdout*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend Artifacts
node_modules/
.npm/

# Unit Test and Coverage Caches
backend/tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Local Database Files
*.sqlite
*.sqlite3
*.db

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE and Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Build, Packaging, and Distribution
build/
dist/
*.egg-info/
.eggs/

# Internal Reports & Technical Audit Documents
RON_AI_*.md
